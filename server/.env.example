# IntelliCare Server Environment Variables
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/intellicare?retryWrites=true&w=majority

# JWT & Session Cryptographic Secrets (Must be min 32/64 hex characters in production)
JWT_ACCESS_SECRET=your_256_bit_jwt_access_secret_hex
JWT_REFRESH_SECRET=your_256_bit_jwt_refresh_secret_hex
SESSION_SECRET=your_256_bit_session_secret_hex
COOKIE_SECRET=your_256_bit_cookie_secret_hex
DATA_ENCRYPTION_KEY=your_256_bit_data_encryption_key_hex

# Mailjet Transactional Email Service
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_SENDER_EMAIL=your_verified_sender@domain.com
MAILJET_SENDER_NAME=IntelliCare AI Operations

# Google OAuth 2.0 / OpenID Connect (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/oauth/google/callback

# Security & Cookies
COOKIE_DOMAIN=
# For cross-site frontend (e.g. Vercel) and backend (e.g. Render), set COOKIE_SAME_SITE=none
COOKIE_SAME_SITE=lax
