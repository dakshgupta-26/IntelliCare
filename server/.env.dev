# Local development mode: `npm run dev:local`
# No credentials needed. Uses a local MongoDB (brew services start mongodb-community),
# placeholder secrets, and prints verification codes / reset links to this server's console.
APP_ENV=dev
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
MONGODB_URI=mongodb://127.0.0.1:27017/intellicare_dev
